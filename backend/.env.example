# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SESSION_PATH=./sessions

# WhatsApp (Baileys) settings
# Sessions will be stored under `${SESSION_PATH}/baileys/<userId>`
# HEADLESS/CHROME_PATH/WA_WEB_VERSION are ignored now (no Puppeteer)
HEADLESS=true
CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
WA_WEB_VERSION=2.2412.54
WA_QR_MAX_RETRIES=48
WA_AUTH_TIMEOUT_MS=600000

# Typing behavior (optional)
WA_TYPING_ENABLED=false
# WA_TYPING_KEEPALIVE_MS=4000

# Optional: your existing app/env vars below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority&appName=<app>
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=change_me
AI_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MEITUAN_API_KEY=
GROQ_API_KEY=
AI_MODEL_GEMINI=gemini-1.5-flash
AI_MODEL_DEEPSEEK=deepseek-chat
AI_MODEL_OPENROUTER=deepseek/deepseek-chat
AI_MODEL_MEITUAN=deepseek/deepseek-chat
AI_MODEL_GROQ=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
